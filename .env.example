# Copy to .env; fill locally. Never commit your .env or service-account JSON.
BATTERYFLOW_MODE=auto
FIREBASE_PROJECT_ID=ls-battery-project
FIREBASE_WEB_API_KEY=
# Blank: auto-detect exactly one *firebase-adminsdk*.json in the project root.
# Multiple files: enter the chosen filename, relative to project root.
FIREBASE_SERVICE_ACCOUNT_FILE=
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
# Login audit log (AES-256-GCM for personal data, HMAC-SHA256 lookup index).
# Generate once with: .venv\Scripts\python.exe -m backend.auth_log init-keys
# Every teammate must use the same keys to read the same logs. Never commit real keys.
LOG_KEY_ID=k1
LOG_ENC_KEY=
LOG_HMAC_KEY=
LOG_RETENTION_DAYS=180
# start_local.cmd auto-allows this PC's current LAN IP. Optional extra hostnames/IPs: comma-separated, no port.
ALLOWED_HOSTS=

# Portfolio mode: personal key only; no fallback to GEMINI_API_KEY above.
PORTFOLIO_GEMINI_API_KEY=
# local: bundled data; firestore: read analysis from your configured Firebase project.
# Visitor sessions/quotas stay local in both modes. No Firebase Auth required.
PORTFOLIO_DATA_SOURCE=local
PORTFOLIO_VISITOR_DAILY_LIMIT=5
PORTFOLIO_GLOBAL_DAILY_LIMIT=100
PORTFOLIO_IP_DAILY_LIMIT=20
# Persist this file across restarts/deployments. One shared DB for all workers.
PORTFOLIO_DB=.local/portfolio/visitors.sqlite3
